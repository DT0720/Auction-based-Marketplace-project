{
  "extends": "next",
  "rules": {
    "@typescript-eslint/no-unused-vars": "off",
    "react/display-name": "off",
    "react-hooks/rules-of-hooks": "off", // Disables rules for hooks
    "react-hooks/exhaustive-deps": "off", // Disables dependency checking for useEffect
    "react/no-unescaped-entities": "off",
    "@next/next/no-page-custom-font": "off"
  }
}
